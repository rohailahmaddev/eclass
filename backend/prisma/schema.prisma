generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

// Global (platform-level) role. Never changes when someone becomes host/manager.
enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum UserStatus {
  active
  suspended
  disabled
}

enum AuthTokenType {
  email_verification
  password_reset
}

enum SessionStatus {
  scheduled
  live
  ended
}

enum EnrollmentStatus {
  active
  suspended
  removed
}

// Classroom-scoped role stored on Enrollment (CR = host, GR = manager).
enum ClassroomMemberRole {
  student
  host
  manager
}

// Role a participant held at the moment they joined a session.
// "teacher" = classroom owner (owner has no Enrollment row).
enum ParticipantRole {
  teacher
  host
  manager
  student
}

enum SessionEndReason {
  host_ended // a teacher, host or manager clicked "End Session"
  all_left   // every participant left (after a grace period)
  system     // server cleanup, e.g. a session left "live" after a crash
}

enum InvitationStatus {
  pending
  accepted
  revoked
}

// ---------------------------------------------------------------------------
// Identity & authentication
// ---------------------------------------------------------------------------

model User {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String     @unique @db.Citext
  passwordHash String     @map("password_hash") // bcrypt / argon2 hash, never plaintext
  fullName     String     @map("full_name") @db.VarChar(120)
  role         Role
  status       UserStatus @default(active)

  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
  avatarUrl       String?   @map("avatar_url")

  // login protection
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz(6)
  lastLoginAt         DateTime? @map("last_login_at") @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  refreshSessions       RefreshSession[]
  authTokens            AuthToken[]
  ownedClassrooms       Classroom[]              @relation("ClassroomOwner")
  invitationsSent       ClassroomInvitation[]    @relation("InvitedBy")
  invitationsAccepted   ClassroomInvitation[]    @relation("AcceptedBy")
  enrollments           Enrollment[]             @relation("EnrollmentStudent")
  enrollmentRoleChanges Enrollment[]             @relation("EnrollmentRoleChangedBy")
  sessionsStarted       LiveSession[]            @relation("SessionStartedBy")
  sessionsEnded         LiveSession[]            @relation("SessionEndedBy")
  sessionParticipants   LiveSessionParticipant[]

  @@map("users")
}

// Keeps a user logged in: one row per refresh token, rotated on every refresh.
model RefreshSession {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId   String @map("user_id") @db.Uuid
  familyId String @map("family_id") @db.Uuid // all tokens from one login share this

  tokenHash String @unique @map("token_hash") @db.VarChar(64) // SHA-256 hex of the raw token

  userAgent String? @map("user_agent") @db.VarChar(255)
  ipAddress String? @map("ip_address") @db.Inet

  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6) // logout, rotation, or reuse detection
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

// Single-use tokens sent by email: verify email address, reset password.
// No "used" flag: the row is DELETED in the same transaction that consumes it.
model AuthToken {
  id     String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String        @map("user_id") @db.Uuid
  type   AuthTokenType

  tokenHash String @unique @map("token_hash") @db.VarChar(64) // SHA-256 hex of the raw token

  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
  @@map("auth_tokens")
}

// ---------------------------------------------------------------------------
// Classroom access control
// ---------------------------------------------------------------------------

// Service-layer rules (not expressible in Prisma):
//  - owner must have global role TEACHER (or ADMIN)
//  - owner must not also be enrolled as a student in the same classroom
//  - classrooms are soft-deleted (deletedAt); children use Restrict so nothing
//    is silently cascaded away.
model Classroom {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId      String  @map("owner_id") @db.Uuid
  title        String  @db.VarChar(100) // e.g. "Web Development — Section A"
  description  String? @db.Text
  scheduleInfo String? @map("schedule_info") @db.VarChar(255) // free text; structured timing lives in live_sessions

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  owner        User                  @relation("ClassroomOwner", fields: [ownerId], references: [id])
  liveSessions LiveSession[]
  invitations  ClassroomInvitation[]
  enrollments  Enrollment[]

  @@index([ownerId])
  @@map("classrooms")
}

// One row per (classroom, email). To re-invite someone whose invitation was
// revoked (or who was removed), REUSE the row: set status = pending, issue a new
// tokenHash and expiresAt, clear acceptedById / acceptedAt.
model ClassroomInvitation {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classroomId String @map("classroom_id") @db.Uuid

  email     String           @db.Citext // case-insensitive, like users.email
  status    InvitationStatus @default(pending)
  tokenHash String           @unique @map("token_hash") @db.VarChar(64)

  invitedById  String    @map("invited_by_id") @db.Uuid // teacher / host / manager who invited
  acceptedById String?   @map("accepted_by_id") @db.Uuid // the account that claimed it
  acceptedAt   DateTime? @map("accepted_at") @db.Timestamptz(6)
  expiresAt    DateTime? @map("expires_at") @db.Timestamptz(6) // NULL = never expires

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  classroom  Classroom @relation(fields: [classroomId], references: [id], onDelete: Restrict)
  invitedBy  User      @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Restrict)
  acceptedBy User?     @relation("AcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@unique([classroomId, email]) // one invitation per email per classroom
  @@index([email, status])       // registration gate: "does this email have a pending invite?"
  @@index([classroomId, status]) // teacher's list of pending / accepted students
  @@map("classroom_invitations")
}

// Classroom membership + classroom-scoped role (student / host / manager).
// The owner/teacher does NOT get a row here; Classroom.ownerId covers them.
model Enrollment {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classroomId String              @map("classroom_id") @db.Uuid
  studentId   String              @map("student_id") @db.Uuid
  role        ClassroomMemberRole @default(student)
  status      EnrollmentStatus    @default(active)

  enrolledAt DateTime  @default(now()) @map("enrolled_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt  DateTime? @map("removed_at") @db.Timestamptz(6)

  // audit: who last changed this member's role, and when
  roleChangedById String?   @map("role_changed_by_id") @db.Uuid
  roleChangedAt   DateTime? @map("role_changed_at") @db.Timestamptz(6)

  classroom     Classroom @relation(fields: [classroomId], references: [id], onDelete: Restrict)
  student       User      @relation("EnrollmentStudent", fields: [studentId], references: [id], onDelete: Restrict)
  roleChangedBy User?     @relation("EnrollmentRoleChangedBy", fields: [roleChangedById], references: [id], onDelete: SetNull)

  @@unique([classroomId, studentId])
  @@index([studentId, status])    // student dashboard
  @@index([classroomId, status])  // classroom member list
  @@map("enrollments")
}

// ---------------------------------------------------------------------------
// FR-6 / FR-7: live sessions
// ---------------------------------------------------------------------------

// One row per class meeting. Deliberately NO max-duration field (FR-6):
// a session ends only when ended_at is set by a teacher/host/manager or by "all left".
model LiveSession {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classroomId String @map("classroom_id") @db.Uuid

  title          String?       @db.VarChar(150) // e.g. "React Hooks — Live Lecture"
  status         SessionStatus @default(scheduled)
  scheduledStart DateTime?     @map("scheduled_start") @db.Timestamptz(6) // optional plan
  startedAt      DateTime?     @map("started_at") @db.Timestamptz(6)      // set when it goes live
  endedAt        DateTime?     @map("ended_at") @db.Timestamptz(6)

  startedById String?           @map("started_by_id") @db.Uuid
  endedById   String?           @map("ended_by_id") @db.Uuid // NULL if ended by all_left / system
  endReason   SessionEndReason? @map("end_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  classroom    Classroom                @relation(fields: [classroomId], references: [id], onDelete: Restrict)
  startedBy    User?                    @relation("SessionStartedBy", fields: [startedById], references: [id])
  endedBy      User?                    @relation("SessionEndedBy", fields: [endedById], references: [id])
  participants LiveSessionParticipant[]

  @@index([classroomId, status])
  @@index([classroomId, startedAt])
  @@index([status, updatedAt]) // crash-recovery sweep for stale "live" sessions
  @@map("live_sessions")
}

// One row per join. Reconnects create a new row after the previous one is closed
// (leftAt set). At most one OPEN row (leftAt IS NULL) per user per session,
// enforced by a partial unique index in the migration SQL.
model LiveSessionParticipant {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId  String          @map("session_id") @db.Uuid
  userId     String          @map("user_id") @db.Uuid
  roleAtJoin ParticipantRole @map("role_at_join") // snapshot, survives later demotion

  joinedAt   DateTime  @default(now()) @map("joined_at") @db.Timestamptz(6)
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz(6) // heartbeat; used to recover after a crash
  leftAt     DateTime? @map("left_at") @db.Timestamptz(6)

  session LiveSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  user    User        @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([sessionId, leftAt])
  @@index([userId, joinedAt]) // personal session history
  @@map("live_session_participants")
}
