generator client{
provider = "prisma-client"
output = "../src/generated/prisma"
}

datasource db{
  provider = "postgresql"
}


enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum UserStatus {
  active
  suspended
  disabled
}

enum AuthTokenType {
  email_verification
  password_reset
}

model User {
  id                  String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email               String     @unique @db.Citext
  password            String     @map("password")
  fullName            String     @map("full_name") @db.VarChar(120)
  role                Role
  status              UserStatus @default(active)

  emailVerifiedAt     DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  avatarUrl           String?    @map("avatar_url")

  // login protection
  failedLoginAttempts Int        @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?  @map("locked_until") @db.Timestamptz(6)
  lastLoginAt         DateTime?  @map("last_login_at") @db.Timestamptz(6)

  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime?  @map("deleted_at") @db.Timestamptz(6)

  refreshSessions     RefreshSession[]
  authTokens          AuthToken[]
  invitationsSent     ClassroomInvitation[] @relation("InvitedBy")
  invitationsAccepted     ClassroomInvitation[] @relation("AcceptedBy")

  @@index([role])
  @@map("users")
}

// Keeps a user logged in: one row per refresh token, rotated on every refresh.
model RefreshSession {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid               // all tokens from one login share this

  tokenHash String    @unique @map("token_hash") @db.VarChar(64) // SHA-256 hex of the raw token

  userAgent String?   @map("user_agent") @db.VarChar(255)
  ipAddress String?   @map("ip_address") @db.Inet

  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)    // logout, rotation, or reuse detection
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

// Single-use tokens sent by email: verify email address, reset password.
// There is no "used" flag: the row is DELETED in the same transaction that consumes it.
model AuthToken {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  type      AuthTokenType

  tokenHash String        @unique @map("token_hash") @db.VarChar(64) // SHA-256 hex of the raw token

  expiresAt DateTime      @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
  @@map("auth_tokens")
}

// ---------------------------------------------------------------------------
// Classroom access control
// ---------------------------------------------------------------------------

enum InvitationStatus {
  pending
  accepted
  revoked
}

model Course {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String      @unique @db.VarChar(30)
  title     String      @db.VarChar(150)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  classrooms Classroom[]

  @@map("courses")
}

model Classroom {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId  String    @map("course_id") @db.Uuid
  name      String    @db.VarChar(100)                       // e.g. "Section A"
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  course      Course                @relation(fields: [courseId], references: [id])
  invitations ClassroomInvitation[]

  @@index([courseId])
  @@map("classrooms")
}

model ClassroomInvitation {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classroomId  String           @map("classroom_id") @db.Uuid

  email        String           @db.Citext                   // case-insensitive, like users.email
  status       InvitationStatus @default(pending)

  invitedById  String           @map("invited_by_id") @db.Uuid   // the teacher / admin who added it
  acceptedById String?          @map("accepted_by_id") @db.Uuid  // the student account that claimed it
  acceptedAt   DateTime?        @map("accepted_at") @db.Timestamptz(6)
  expiresAt    DateTime?        @map("expires_at") @db.Timestamptz(6) // NULL = never expires

  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  classroom    Classroom        @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  invitedBy    User             @relation("InvitedBy", fields: [invitedById], references: [id])
  acceptedBy   User?            @relation("AcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@unique([classroomId, email])        // one invitation per email per classroom
  @@index([email, status])              // registration gate: "does this email have a pending invite?"
  @@index([classroomId, status])        // teacher's list of pending / accepted students
  @@map("classroom_invitations")
}

