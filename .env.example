# PostgreSQL
POSTGRES_USER=eclass_user
POSTGRES_PASSWORD=strong_password
POSTGRES_DB=eclass_dev

# Backend
PORT=port number
NODE_ENV=environment

# Database connection
DATABASE_URL="postgresql://eclass_user:strong_password@localhost:5432/eclass_dev?schema=public"


# JWT Token
ACCESS_TOKEN_SECRET=time
ACCESS_TOKEN_SECRET=secret key of access token

REFRESH_TOKEN_EXPIRY=time
REFRESH_TOKEN_SECRET=secret key of refresh token

TEMPORARY_TOKEN_SECRET=secret key of temporary token

# Cloudinary
CLOUD_NAME=cloud name
CLOUDINARY_API_KEY=cloudinary api key of cloudinary
CLOUDINARY_API_SECRET=cloudinary api secret

# Resend Email
RESEND_API_KEY=resend api key
EMAIL_FROM=your verified domain
FRONTEND_URL=frontend url
APP_NAME=app name
